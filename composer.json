{
    "name": "jekabs/laravel-rag",
    "description": "Laravel RAG package with AST-aware code extractors, knowledge graph, multi-hop search, pgvector semantic search, BM25 keyword search, and Reciprocal Rank Fusion.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Jekabs Porietis",
            "email": "jekabsporietis@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Jekabs\\LaravelRag\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jekabs\\LaravelRag\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jekabs\\LaravelRag\\LaravelRagServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "keywords": ["laravel", "rag", "vector-search", "pgvector", "knowledge-graph", "ast", "php-parser", "embeddings", "ai"]
}
